# Copy to .env for local development. Empty secrets are intentional: set private
# values locally, and set production values in Render's Environment settings.
# Never commit real credentials or API keys.

NODE_ENV="development"
DEMO_MODE="true"
PORT=3000
DATA_DIR="./data"
# Production-only, temporary demo mode. If enabled, DATA_DIR must be inside
# the OS temp directory (Render Free: /tmp/campuscare-data). Data is lost on
# restart/redeploy and all sessions expire. Leave unset/false for persistent storage.
# ALLOW_EPHEMERAL_DATA=false
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS=

# Use a random, persistent value of at least 32 bytes in production.
# Development can generate a temporary value when this is empty.
AUTH_SECRET=

# Optional for local development; Render can inject PORT automatically.
GEMINI_API_KEY=
ALLOWED_COLLEGE_EMAIL_DOMAIN=".edu.in"

# Legacy Main Admin account. ADMIN_EMAIL defaults to admin@college.edu.
ADMIN_EMAIL="admin@college.edu"
ADMIN_PASSWORD=

# Set each map to a JSON object with every supported account email as a key.
# Every password must be unique and 12-200 characters in production.
# Example shape only (do not use blank/example passwords):
# STAFF_CREDENTIALS={"warden@college.edu":"<unique-password>",...}
# SECTOR_ADMIN_CREDENTIALS={"it.admin@college.edu":"<unique-password>",...}
STAFF_CREDENTIALS=
SECTOR_ADMIN_CREDENTIALS=

# Initial Super Admin. Its account is stored on first startup; later environment
# changes do not reset its stored password.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Student OTP email is optional in local demo mode and required in production.
# Verify the sender domain in Resend before using its API key and sender address.
EMAIL_PROVIDER=
RESEND_API_KEY=
OTP_FROM_EMAIL=
