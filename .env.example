# ===================================================
# CampusCare Environment Configuration (.env.example)
# Copy this file to .env and provide your values.
# NEVER commit real secret values to GitHub.
# ===================================================

# GEMINI_API_KEY: Google Gemini API Key for AI triage & sentiment analysis
GEMINI_API_KEY=""

# AUTH_SECRET: Use a random, persistent value (at least 32 bytes in production). Development generates one if omitted.
AUTH_SECRET=""

# DEMO_MODE: Enable instant demo logins for local development only.
DEMO_MODE="true"

# ALLOWED_COLLEGE_EMAIL_DOMAIN: Optional official college email domain filter (default: .edu.in)
ALLOWED_COLLEGE_EMAIL_DOMAIN=".edu.in"

# PORT: Server port (defaults to 3000 locally; Render automatically injects PORT)
PORT=3000

# NODE_ENV: Set to 'production' on live deployment
NODE_ENV="development"

# ADMIN / SECTOR ADMIN / MAIN ADMIN CREDENTIALS
# Main Admin: admin@college.edu (or set below)
# Set unique passwords (12+ characters in production) to enable the legacy admin and staff login routes.
# These routes are disabled when the corresponding password is empty.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=
STAFF_PASSWORD=

# Initial Super Admin (password must be at least 12 characters).
# The account is created once; changing these values does not overwrite a stored password.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional storage directory. On Render, set this to the persistent disk mount path.
DATA_DIR=

# Sector Admins use predefined emails (e.g., it.admin@college.edu, electrical.admin@college.edu, etc.)
# All sector admins share the ADMIN_PASSWORD above for simplicity.
