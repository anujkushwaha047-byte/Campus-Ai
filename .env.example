# ===================================================
# CampusCare Environment Configuration (.env.example)
# Copy this file to .env and provide your values.
# NEVER commit real secret values to GitHub.
# ===================================================

# GEMINI_API_KEY: Google Gemini API Key for AI triage & sentiment analysis
GEMINI_API_KEY=""

# AUTH_SECRET: Use a random, persistent value (at least 32 bytes in production). Development generates one if omitted.
AUTH_SECRET=""

# DEMO_MODE: Enable instant demo logins for local development only.
DEMO_MODE="true"

# ALLOWED_COLLEGE_EMAIL_DOMAIN: Optional official college email domain filter (default: .edu.in)
ALLOWED_COLLEGE_EMAIL_DOMAIN=".edu.in"

# PORT: Server port (defaults to 3000 locally; Render automatically injects PORT)
PORT=3000

# NODE_ENV: Set to 'production' on live deployment
NODE_ENV="development"

# APP_URL: Exact public origin. Required in production; optional for local development.
APP_URL=
# CORS_ALLOWED_ORIGINS: Optional comma-separated list of additional exact origins.
CORS_ALLOWED_ORIGINS=

# MAIN ADMIN / SECTOR ADMIN CREDENTIALS
# Main Admin: admin@college.edu (or set below)
# Sector Admin credentials are JSON keyed by the sector emails configured in server.ts.
# Each production sector account must have a distinct 12+ character password.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=
SECTOR_ADMIN_CREDENTIALS=

# Warden / Department Staff credentials are JSON keyed by the staff emails in server.ts.
# Each production account must have a distinct 12+ character password.
STAFF_CREDENTIALS=
# Local demo-only compatibility fallback; ignored in production.
STAFF_PASSWORD=

# Initial Super Admin (password must be at least 12 characters).
# The account is created once; changing these values does not overwrite a stored password.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional storage directory. On Render, set this to the persistent disk mount path.
DATA_DIR=

# Student OTP delivery is demo-only until a real email provider is integrated.

# ADMIN_PASSWORD is only for ADMIN_EMAIL; sector admins use their individual credentials above.
